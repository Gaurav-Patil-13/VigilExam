# ==============================================================================
# VigilExam - Environment Configuration Template
# Copy this file to .env and configure your credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Atlas Connection
# Database Username: rugvedganapule_db_user
# Hostname: cluster0.tcfl6zh.mongodb.net
# Protocol: mongodb+srv://
# Database Name: vigilexam
# Replace <PASSWORD> with your rotated database password (URL-encoded if special characters exist):
MONGODB_URI=mongodb+srv://rugvedganapule_db_user:<2AUZcAGVIbj3gZoc>@cluster0.tcfl6zh.mongodb.net/vigilexam?retryWrites=true&w=majority
DB_NAME=vigilexam

# Administrative Bootstrap Key (Required for registering Admin accounts)
ADMIN_BOOTSTRAP_KEY=VigilExam-Admin-Root-2026

# JWT HMAC-SHA256 Signing Secret
VIGILEXAM_JWT_SECRET=vigilexam-secure-hmac-key-2026-exam-integrity

# Development Security Policy Flag
# Set to 'true' to allow VS Code (Code.exe) during development testing
ALLOW_VSCODE_DURING_DEVELOPMENT=true

# Background Applications Policy
# Set to 'true' to allow general background processes and non-essential applications
ALLOW_BACKGROUND_PROCESSES=true
